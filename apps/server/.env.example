# Copy to `.env` for local development. In production these are set as service
# variables in the Railway dashboard — never commit a filled-in .env.
#
# Every variable here is validated at boot by src/lib/env.ts. A missing or
# malformed one crashes the process immediately and names what's wrong.

# "development" locally, "production" on Railway. This is what switches the
# session cookie into cross-site mode — see src/lib/auth.ts.
NODE_ENV=development

# Railway injects PORT at runtime; do not set it on the service. Local only.
PORT=4000

# Origin of the Next.js client, no trailing slash. Used for CORS and as a
# better-auth trusted origin, so it must match the browser's Origin exactly.
CLIENT_URL=http://localhost:3000

# OPTIONAL, and the single most valuable variable to set in production.
#
# Set it only when the client and API run on subdomains of one registrable
# domain — e.g. client on app.example.com, API on api.example.com — then use
# ".example.com". The session cookie becomes same-site and every browser
# accepts it.
#
# Left unset in production, the two are treated as cross-site and the cookie is
# sent with SameSite=None. That works on Railway's default *.up.railway.app
# domains (they are separate sites — up.railway.app is on the Public Suffix
# List) but Safari blocks third-party cookies, so sign-in will fail there.
# COOKIE_DOMAIN=.example.com

# On Railway, reference the Postgres service instead of pasting a URL:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/railway_controller

# Public URL of this API itself — the origin OAuth providers redirect back to.
BETTER_AUTH_URL=http://localhost:4000

# At least 32 characters. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Authorized redirect URI to register with each provider:
#   <BETTER_AUTH_URL>/api/auth/callback/google
#   <BETTER_AUTH_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

RAILWAY_ENDPOINT=https://backboard.railway.com/graphql/v2

# Exactly 32 bytes, base64-encoded — this is the AES-256-GCM key that user
# Railway tokens are encrypted with. Generate with:
#   openssl rand -base64 32
#
# Rotating it makes every stored token undecryptable; users would have to
# reconnect. Back it up somewhere durable before the first deploy.
ENCRYPTION_KEY=
