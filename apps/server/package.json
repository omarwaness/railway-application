{
    "name": "railway-controller-server",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "test": "bun test src/tests --timeout 30000",
        "test:routes": "bun test src/tests/routes.test.ts --timeout 300000",
        "generate": "drizzle-kit generate",
        "codegen": "graphql-codegen --config codegen.ts",
        "migrate": "npx drizzle-kit migrate"
    },
    "dependencies": {
        "@graphql-typed-document-node/core": "^3.2.0",
        "@hono/standard-validator": "^0.3.0",
        "better-auth": "^1.6.26",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "graphql": "^16",
        "graphql-request": "^7.4.0",
        "hono": "^4.13.0",
        "postgres": "^3.4.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.2.0",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5.9.2"
    }
}