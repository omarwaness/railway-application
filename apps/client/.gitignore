# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents what a deploy needs and holds no
# values. This negation is required here: the root .gitignore has the same
# rule, but the closest .gitignore wins and would otherwise ignore it.
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
